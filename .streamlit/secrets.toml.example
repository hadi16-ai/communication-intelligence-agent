# Template for .streamlit/secrets.toml — used by Streamlit Community Cloud's
# "Secrets" settings panel (paste this content there, filled in) and,
# optionally, for local development instead of a .env file.
#
# Never commit an actual .streamlit/secrets.toml — it is already covered by
# .gitignore. This .example file has no real values and is safe to commit.
#
# app/streamlit_app.py bridges these into os.environ at startup, so the
# existing Settings (pydantic-settings) picks them up unchanged — no code
# differs between local and deployed runs.

GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3-flash-preview"

# SQLite storage. Streamlit Community Cloud's filesystem is EPHEMERAL: it
# resets on every redeploy/restart, so this database does not persist
# long-term on Cloud. Fine for a demo; for durable storage, point this at
# an external database in a future version.
DATABASE_PATH = "data/app.db"

LOG_LEVEL = "INFO"

# --- Gmail (optional) ---
# The interactive OAuth consent flow (scripts/authorize_gmail.py) cannot
# run on a headless Cloud server — it opens a local browser window. To make
# the deployed Gmail tab usable anyway, run that script locally FIRST (on
# your own machine, signing into your own Google account), then paste the
# resulting credentials/token.json file's contents here as GMAIL_TOKEN_JSON.
# app/streamlit_app.py writes it to GMAIL_TOKEN_PATH on startup if that file
# doesn't already exist. This token only ever grants gmail.readonly access —
# exactly the same scope as running the script locally.
# GMAIL_TOKEN_JSON = '{"token": "...", "refresh_token": "...", ...}'
GMAIL_CLIENT_SECRET_PATH = "credentials/client_secret.json"
GMAIL_TOKEN_PATH = "credentials/token.json"
GMAIL_FETCH_MAX_RESULTS = 10
