# --- AI provider selection ---
# "anthropic" (default) or "gemini" — both classifiers exist in the
# codebase; this only selects which one app.ai.classifier.get_classifier()
# builds. Only the selected provider's API key is required.
AI_PROVIDER=anthropic

# --- Claude (default provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Gmail OAuth (paths only — never commit the actual credential files) ---
GMAIL_CLIENT_SECRET_PATH=credentials/client_secret.json
GMAIL_TOKEN_PATH=credentials/token.json
# Maximum number of recent messages fetched per manual Gmail sync (Streamlit "Gmail" tab / M10)
GMAIL_FETCH_MAX_RESULTS=10

# --- Storage ---
DATABASE_PATH=data/app.db

# --- Logging ---
LOG_LEVEL=INFO
